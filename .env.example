# ---------- Affichage ----------
# true = affiche les badges « DÉMO » sur les contenus inventés (relecture). Défaut : masqués.
PUBLIC_SHOW_DEMO=

# ---------- Leads (fonction serverless src/pages/api/lead.ts) ----------
# Jeton d'application privée HubSpot (scopes : crm.objects.contacts.write / read).
# Sans jeton : mode mock, le lead est loggé côté serveur et le succès est simulé.
HUBSPOT_ACCESS_TOKEN=
# Webhook Slack facultatif : une alerte par lead.
SLACK_WEBHOOK_URL=
# Cloudflare Turnstile (captcha des formulaires). Clé de site (publique) + clé secrète (vérification dans /api/lead).
# Sans ces deux variables : pas de widget, pas de vérification. Clés de test Cloudflare : 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Prise de rendez-vous ----------
# Lien HubSpot Meetings (ex. https://meetings-eu1.hubspot.com/prenom/15min). Vide = placeholder.
# Agenda de rendez-vous. Vide = l'agenda Google Calendar KOSMO® (src/lib/env.ts). Un lien HubSpot Meetings marche aussi.
PUBLIC_BOOKING_URL=

# ---------- Canaux ----------
# Numéro WhatsApp au format international sans « + ». Défaut : le numéro de la référence.
PUBLIC_WHATSAPP_NUMBER=971526713890

# ---------- Analytics (chaque outil ne se charge que si sa variable est renseignée) ----------
# Plausible : sans cookies, chargé sans consentement.
PUBLIC_PLAUSIBLE_DOMAIN=
# Les suivants ne se chargent qu'après consentement (bandeau cookies).
PUBLIC_GA4_ID=
PUBLIC_RB2B_KEY=
PUBLIC_CONTENTSQUARE_ID=
PUBLIC_CLARITY_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_META_PIXEL_ID=
# true = script Vercel Web Analytics (sans cookies).
PUBLIC_VERCEL_ANALYTICS=
