---
/**
 * Bloc « concept gratuit » (DESIGN-SYSTEM.md) réutilisé sur les cas, le journal, the shift… : panneau noir à grille et
 * faisceau (GridBeam)
 * (étiquette acide, titre deux tons, texte secondaire, bouton blanc + bouton verre), film FOOH dans une fenêtre card-dark
 * posée en biais ([data-tilt], voir animations.ts) qui se redresse au survol.
 * Pas de livrables détaillés, pas d'urgence : un concept pour votre écran, et l'invitation à réserver un call.
 */
import Button from './Button.astro';
import Demo from './Demo.astro';
import TwoTone from './TwoTone.astro';
import GridBeam from './GridBeam.astro';
import { conceptCta } from '../../data/3dooh';
import { conceptLabel, bookLabel } from '../../data/site';

interface Props {
  conceptHref?: string;
  /** compact = sans image (bandeau). */
  compact?: boolean;
  /** sidebar = version étroite (colonne sticky) : titre réduit, boutons empilés. */
  sidebar?: boolean;
  class?: string;
}
const { conceptHref = '/contact#brief', sidebar = false, compact = sidebar, class: className } = Astro.props;
---

<Demo when={conceptCta.demo} note="texte du bloc concept gratuit" class={className}>
  <div class="tone-dark relative isolate overflow-hidden rounded-sm bg-black">
    <GridBeam at={compact ? 'end' : 'center'} />
    <div class:list={['grid items-center gap-8 max-sm:p-5', sidebar ? 'p-5' : 'p-8', compact ? 'grid-cols-1' : 'grid-cols-(--process-card-cols) max-lg:grid-cols-1']}>
      <div class="flex flex-col gap-4">
        <div class="text-tagline text-acid">{conceptCta.overline}</div>
        <h2 class:list={['max-w-(--measure-2xl)', sidebar ? 'heading-h6' : 'heading-h4']}>{sidebar ? conceptCta.heading : <TwoTone text={conceptCta.heading} />}</h2>
        <p class:list={['max-w-(--measure-2xl) text-(--body-soft)', sidebar ? 'text-small' : 'text-body-medium']}>{conceptCta.text}</p>
        <div class:list={['flex gap-2 pt-2', sidebar ? 'flex-col [&>*]:w-full' : 'flex-wrap']}>
          <Button href={conceptHref} label={conceptLabel} variant="light" data-track-click="concept_cta" />
          <Button href="/book" label={bookLabel} variant="outline" data-track-click="concept_cta_book" />
        </div>
      </div>
      {
        !compact && (
          <div data-tilt class="card-dark relative ml-auto aspect-portrait w-full max-w-(--cta-image-max) p-(--card-pad) max-lg:mx-auto">
            <video data-lazy data-src={conceptCta.video.src} poster={conceptCta.video.poster} muted loop playsinline preload="none" aria-label={conceptCta.video.alt} class="size-full rounded-default object-cover"></video>
          </div>
        )
      }
    </div>
  </div>
</Demo>
