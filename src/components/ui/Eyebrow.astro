---
/**
 * Surtitre : étiquette Inconsolata en capitales + filet qui se trace jusqu'au bord droit (data-eyebrow, animations.ts).
 * Couleurs lues dans le contexte (--label-color, --eyebrow-track) : la section sombre (tone-dark) les inverse.
 */
interface Props {
  label: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const { label, tone, class: className } = Astro.props;
---

<div data-eyebrow="trigger" data-fade="target" class:list={['flex items-center gap-(--eyebrow-gap)', tone === 'dark' && 'tone-dark', className]}>
  <div class="text-tagline text-(--label-color)">{label}</div>
  <div class="relative h-px min-w-0 flex-1">
    <div data-eyebrow="target" class="h-px w-0 bg-(--eyebrow-track)"></div>
  </div>
</div>
