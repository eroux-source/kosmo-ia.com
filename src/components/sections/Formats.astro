---
/**
 * Services de la 3D anamorphique (/3dooh, pages villes), d'après la référence « cartes à coin coupé » validée par Mehdi
 * le 22/10/2026, à l'ADN KOSMO® : quatre cases blanches à coin coupé (liseré 1 px qui suit la coupe), titre de carte,
 * flèche qui pivote vers le coin haut droit au survol et se tasse au clic, texte, puis la photo (une scène anamorphique par service)
 * qui occupe tout le bas de la case, sous un léger effet LED (src/scripts/led-screen.ts). La case monte légèrement au survol. Bandeau « concept gratuit » dessous (`ctaHref`). Données : src/data/formats.ts.
 * Pages de service (/3dooh/<service>) : `data` remplace les textes et les cases (trois lieux, sans lien ni flèche).
 * Sur mobile (≤ 767 px), les cases forment un rail qui défile au doigt (global.css [data-rail]) au lieu d'une colonne.
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Demo from '../ui/Demo.astro';
import TwoTone from '../ui/TwoTone.astro';
import Icon from '../ui/Icon.astro';
import ConceptCta from '../ui/ConceptCta.astro';
import { formats } from '../../data/formats';

interface Item {
  demo?: boolean;
  title: string;
  text: string;
  image: { src: string; alt: string };
  /** Sans lien, la case n'a pas de flèche et ne monte pas au survol. */
  href?: string;
}
interface Props {
  id?: string;
  /** Bandeau « concept gratuit » sous les cartes (lien vers le formulaire d'offre). */
  ctaHref?: string;
  /** Textes et cases d'une page de service (par défaut : les quatre services de src/data/formats.ts). */
  data?: { overline: string; heading: string; intro: string; items: Item[] };
}
const { id, ctaHref, data } = Astro.props;
const section = data ?? { overline: formats.overline, heading: formats.heading.text, intro: formats.intro.text, items: formats.items as Item[] };
const cols = section.items.length === 3 ? 'grid-cols-3 max-md:grid-cols-1' : 'grid-cols-4 max-lg:grid-cols-2 max-sm:grid-cols-1';
---

<Section id={id} data-fade="trigger" class="scroll-mt-(--nav-inset)">
  <Eyebrow label={section.overline} />
  <div class="mt-(--head-gap) grid grid-cols-2 items-end gap-10 max-lg:grid-cols-1">
    <Demo inline note="titre de la section services anamorphiques">
      <h2 data-stagger-text class="heading-h3"><TwoTone text={section.heading} /></h2>
    </Demo>
    <Demo inline note="intro de la section services anamorphiques">
      <p data-fade="target" class="max-w-(--head-intro-max) justify-self-end text-body-medium text-(--body-soft) max-lg:justify-self-start">{section.intro}</p>
    </Demo>
  </div>
  <ul data-fade="target" data-rail class:list={['mt-12 grid gap-3', cols]}>
    {
      section.items.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        return (
        <li class="flex">
          <Demo when={item.demo ?? false} note="texte du service à valider" class="flex w-full">
            <Tag href={item.href} class:list={['service-card group relative isolate flex w-full flex-col text-black', item.href && 'transition-transform duration-(--duration-surface) ease-(--ease-kosmo) hover:-translate-y-1']}>
              <span class="flex flex-col p-(--service-card-pad)">
                <span class="flex items-start justify-between gap-4">
                  <h3 class="min-h-(--service-card-title-h) heading-h6 font-extrabold tracking-(--h3-tracking) uppercase max-lg:min-h-0">{item.title}</h3>
                  {item.href && (
                    <span aria-hidden="true" class="grid size-(--button-sm-height) shrink-0 place-items-center transition-[scale] duration-(--duration-color) group-active:scale-(--button-go-press)">
                      <Icon name="arrow-right" class="size-(--case-arrow) transition-transform duration-(--duration-surface) ease-(--ease-kosmo) group-hover:-rotate-45" />
                    </span>
                  )}
                </span>
                <p class="mt-(--service-card-text-gap) text-body-small text-(--body-soft) max-lg:mt-(--service-card-text-gap-mobile)">{item.text}</p>
              </span>
              <span data-led class="relative mx-(--hairline) mt-auto mb-(--hairline) block aspect-5/4 overflow-hidden bg-paper">
                <img src={item.image.src} alt={item.image.alt} loading="lazy" width="1000" height="806" class="size-full object-cover" />
                <canvas aria-hidden="true" class="pointer-events-none absolute inset-0 size-full"></canvas>
              </span>
            </Tag>
          </Demo>
        </li>
        );
      })
    }
  </ul>
  {ctaHref && <ConceptCta conceptHref={ctaHref} compact class="mt-3 block" />}
</Section>

<script>
  import '../../scripts/led-screen';
</script>

