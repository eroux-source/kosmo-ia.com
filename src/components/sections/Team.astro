---
/**
 * Équipe (DESIGN-SYSTEM.md) : titre de section centré en capitales, le mot mis en avant sur un aplat acide ; cartes
 * « fenêtre » blanches (photo dither à 6 px du bord, nom et rôle dessous) en défilement continu (src/scripts/ticker.ts).
 * Au survol : la photo grossit légèrement et le liseré passe en acide.
 */
import Demo from '../ui/Demo.astro';
import { team } from '../../data/3dooh';

interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<section id={id} data-fade="trigger" class="relative flex flex-col gap-12 overflow-hidden bg-paper py-(--section-md-y) max-lg:py-(--section-md-y-tablet)">
  <div class="px-(--gutter)">
    <div class="mx-auto flex w-full max-w-(--team-header-max) items-center justify-center text-center">
      <Demo inline when={team.heading.demo} note="titre de la section équipe">
        <h2 data-stagger-text class="heading-h3">
          {team.heading.before}
          <span class="rounded-default bg-acid px-2 text-black">{team.heading.highlight}</span>
          {team.heading.after}
        </h2>
      </Demo>
    </div>
  </div>
  <div data-ticker="team" data-fade="target" class="flex">
    <ul data-ticker-track class="flex shrink-0 justify-start gap-3 pr-3">
      {
        team.members.map((member) => (
          <li data-team-card class="card w-(--team-card-width) flex-none p-(--card-pad) transition-shadow duration-(--duration-surface) ease-(--ease-kosmo) hover:shadow-(--card-ring-acid)">
            <div class="aspect-square overflow-hidden rounded-default bg-black">
              <img
                data-team-image
                src={`/images/team/${member.image}.png`}
                srcset={[...member.sizes.map((w) => `/images/team/${member.image}-${w}.png ${w}w`), `/images/team/${member.image}.png 5000w`].join(', ')}
                sizes="12.5rem"
                alt={member.name}
                loading="lazy"
                class="size-full object-cover"
              />
            </div>
            <div class="flex flex-col gap-0.5 px-1.5 pt-2.5 pb-1.5">
              <div class="text-small font-semibold">{member.name}</div>
              <div class="text-tagline text-(--label-color)">{member.role}</div>
              {member.studio && <div class="text-tagline text-(--label-color)">{team.partnerLabel}: {member.studio}</div>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../../scripts/ticker';
</script>
