---
/**
 * Grille des services IA en cartes à coin coupé (même carte que Services.astro) : titre en capitales, flèche qui pivote
 * vers le coin au survol, une ligne, l'affiche du film du service en bas. `current` marque la page en cours.
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import TwoTone from '../ui/TwoTone.astro';
import { services, serviceHref, type AiService } from '../../data/ai';
import { heroOf } from '../../lib/ai-hero';

interface Props {
  id?: string;
  overline?: string;
  heading?: string;
  intro?: string;
  /** Services montrés (par défaut tous). */
  only?: string[];
  current?: string;
}
const { id, overline = 'services', heading = 'Everything a campaign needs. Made with AI.', intro, only, current } = Astro.props;
const list: AiService[] = only ? (only.map((slug) => services.find((s) => s.slug === slug)).filter(Boolean) as AiService[]) : services;
const cover = (s: AiService) => heroOf(s).poster;
---

<Section id={id} data-fade="trigger" class="scroll-mt-(--nav-inset)">
  <Eyebrow label={overline} />
  <div class="mt-(--head-gap) grid grid-cols-2 items-end gap-10 max-lg:grid-cols-1">
    <h2 data-stagger-text class="heading-h3"><TwoTone text={heading} /></h2>
    {intro && <p data-fade="target" class="max-w-(--head-intro-max) justify-self-end text-body-medium text-(--body-soft) max-lg:justify-self-start">{intro}</p>}
  </div>
  <ol class="mt-12 grid grid-cols-3 gap-3 max-lg:grid-cols-2 max-md:grid-cols-1">
    {
      list.map((s) => (
        <li data-fade="target" class="flex">
          <a
            href={serviceHref(s)}
            aria-current={s.slug === current ? 'page' : undefined}
            class="service-card group relative isolate flex w-full flex-col text-black transition-transform duration-(--duration-surface) ease-(--ease-kosmo) hover:-translate-y-1"
          >
            <span class="flex flex-col p-(--service-card-pad)">
              <span class="flex items-start justify-between gap-4">
                <h3 class="heading-h6 font-extrabold tracking-(--h3-tracking) uppercase">{s.label}</h3>
                <span aria-hidden="true" class="grid size-(--button-sm-height) shrink-0 place-items-center">
                  <Icon name="arrow-right" class="size-(--case-arrow) transition-transform duration-(--duration-surface) ease-(--ease-kosmo) group-hover:-rotate-45" />
                </span>
              </span>
              <p class="mt-(--service-card-text-gap-mobile) text-body-small text-(--body-soft)">{s.blurb}</p>
            </span>
            <span class="mx-(--hairline) mt-auto mb-(--hairline) block aspect-video overflow-hidden bg-paper">
              <img src={cover(s)} alt="" loading="lazy" decoding="async" class="size-full object-cover" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Section>
