---
/**
 * Cartes « ce que l'on fait » : en-tête de section (surtitre, titre deux tons, paragraphes à droite), puis des cartes
 * blanches à pastille d'icône acide (même carte que les canaux du Contact).
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import TwoTone from '../ui/TwoTone.astro';
import type { Deliverable } from '../../data/ai';

interface Props {
  id?: string;
  overline: string;
  heading: string;
  text?: string[];
  items: Deliverable[];
  /** Titre de la grille de cartes, sous les paragraphes. */
  itemsHeading?: string;
}
const { id, overline, heading, text = [], items, itemsHeading } = Astro.props;
const cols = items.length % 3 === 0 ? 'grid-cols-3' : 'grid-cols-4';
---

<Section id={id} data-fade="trigger" class="scroll-mt-(--nav-inset)">
  <Eyebrow label={overline} />
  <div class="mt-(--head-gap) grid grid-cols-2 gap-10 max-lg:grid-cols-1">
    <h2 data-stagger-text class="heading-h3"><TwoTone text={heading} /></h2>
    {
      text.length > 0 && (
        <div data-fade="target" class="flex max-w-(--head-intro-max) flex-col gap-4 justify-self-end max-lg:justify-self-start">
          {text.map((p) => <p class="text-body-medium text-(--body-soft)">{p}</p>)}
        </div>
      )
    }
  </div>
  {itemsHeading && <h3 data-fade="target" class="mt-16 heading-h5"><TwoTone text={itemsHeading} /></h3>}
  <ul class:list={['grid gap-3 max-lg:grid-cols-2 max-sm:grid-cols-1', itemsHeading ? 'mt-8' : 'mt-12', cols]}>
    {
      items.map((item) => (
        <li data-fade="target" class="card flex flex-col p-(--way-pad)">
          <span class="grid size-(--way-icon) place-items-center rounded-default bg-acid text-black">
            <Icon name={item.icon} class="size-(--button-icon)" />
          </span>
          <h4 class="mt-5 heading-h6">{item.title}</h4>
          <p class="mt-2 text-small text-(--body-soft)">{item.text}</p>
        </li>
      ))
    }
  </ul>
</Section>
