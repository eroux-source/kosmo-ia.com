---
/**
 * Vitrine de l'influenceur IA de KOSMO® (page AI influencers) : en-tête de section, le lookbook (trois tenues) en carte
 * « fenêtre » pleine largeur, puis l'image éditoriale et le film côte à côte. Mobile : empilés.
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TwoTone from '../ui/TwoTone.astro';
import { influencer } from '../../data/ai-work';

interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<Section id={id} data-fade="trigger" class="scroll-mt-(--nav-inset)">
  <Eyebrow label="made by kosmo®" />
  <div class="mt-(--head-gap) grid grid-cols-2 items-end gap-10 max-lg:grid-cols-1">
    <h2 data-stagger-text class="heading-h3"><TwoTone text="One character. Every look, every scene." /></h2>
    <p data-fade="target" class="max-w-(--head-intro-max) justify-self-end text-body-medium text-(--body-soft) max-lg:justify-self-start">
      Our own AI influencer, designed and produced in house. The same face and the same personality in a lookbook, an editorial shoot and a film: exactly what we build for a brand.
    </p>
  </div>
  <div data-fade="target" class="card mt-12 p-(--card-pad)">
    <img src={influencer.lookbook.src} alt={influencer.lookbook.alt} loading="lazy" decoding="async" class="aspect-video w-full rounded-default bg-white object-contain" />
    <div class="flex items-center justify-between gap-4 p-3">
      <h3 class="heading-h6">The lookbook</h3>
      <span class="chip">Three looks, one character</span>
    </div>
  </div>
  <div class="mt-3 grid grid-cols-2 gap-3 max-md:grid-cols-1">
    <div data-fade="target" class="card p-(--card-pad)">
      <img src={influencer.editorial.src} alt={influencer.editorial.alt} loading="lazy" decoding="async" class="aspect-video w-full rounded-default object-cover" />
      <div class="flex items-center justify-between gap-4 p-3">
        <h3 class="heading-h6">The editorial</h3>
        <span class="chip">Fashion shoot</span>
      </div>
    </div>
    <div data-fade="target" class="card p-(--card-pad)">
      <video class="aspect-video w-full rounded-default bg-black object-cover" data-lazy data-src={influencer.video} poster={influencer.poster} muted loop playsinline preload="none"></video>
      <div class="flex items-center justify-between gap-4 p-3">
        <h3 class="heading-h6">The film</h3>
        <span class="chip">Social and campaign</span>
      </div>
    </div>
  </div>
</Section>
