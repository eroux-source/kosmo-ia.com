---
/**
 * Le constat : deux frises côte à côte, « format classique » (3 cases puis fin du contact) contre « jeu de marque »
 * (7 cases, jusqu'au code utilisé). Les cases s'allument une à une au scroll (src/scripts/play-page.ts, motion.play.track).
 * Pas de chiffre inventé : la longueur de la frise porte le message. Puis trois cartes (pastille acide, comme Contact).
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import TwoTone from '../ui/TwoTone.astro';
import { play } from '../../data/play';

interface Props {
  id?: string;
}
const { id } = Astro.props;
const { compare } = play;
---

<Section id={id} data-fade="trigger" class="scroll-mt-(--nav-inset)">
  <Eyebrow label={compare.overline} />
  <div class="mt-(--head-gap) grid grid-cols-2 items-end gap-10 max-lg:grid-cols-1">
    <h2 data-stagger-text class="heading-h3"><TwoTone text={compare.heading} /></h2>
    <p data-fade="target" class="max-w-(--head-intro-max) justify-self-end text-body-medium text-(--body-soft) max-lg:justify-self-start">{compare.intro}</p>
  </div>

  <div data-fade="target" data-play-track class="card mt-12 overflow-x-auto p-6 max-md:p-4">
    <div class="flex min-w-max flex-col gap-6">
      {
        compare.tracks.map((track) => (
          <div class="grid grid-cols-(--chart-legend-cols) items-center gap-4">
            <span class:list={['text-tagline', track.tone === 'acid' ? 'text-black' : 'text-ink-soft']}>{track.label}</span>
            <ol class="flex items-center gap-2">
              {track.steps.map((step) => (
                <li
                  data-play-cell
                  class:list={[
                    'flex h-(--timeline-bar) min-w-(--play-track-cell) shrink-0 items-center justify-center rounded-default px-3 text-small font-semibold whitespace-nowrap',
                    track.tone === 'acid' ? 'bg-acid text-black' : 'bg-paper text-ink-soft shadow-(--card-ring)',
                  ]}
                >
                  {step}
                </li>
              ))}
              <li data-play-cell class:list={['flex shrink-0 items-center gap-2 pl-2 text-tagline', track.tone === 'acid' ? 'text-black' : 'text-ink-soft']}>
                <Icon name={track.tone === 'acid' ? 'arrow-right' : 'close'} class="size-4" />
                {track.end}
              </li>
            </ol>
          </div>
        ))
      }
      <p class="border-t border-line pt-4 text-tagline text-ink-soft">{compare.legend}</p>
    </div>
  </div>

  <ul class="mt-3 grid grid-cols-3 gap-3 max-lg:grid-cols-1">
    {
      compare.points.map((point) => (
        <li data-fade="target" class="card flex flex-col p-(--way-pad)">
          <span class="grid size-(--way-icon) place-items-center rounded-default bg-acid text-black">
            <Icon name={point.icon} class="size-(--button-icon)" />
          </span>
          <h3 class="mt-5 heading-h6">{point.title}</h3>
          <p class="mt-2 text-small text-ink-soft">{point.text}</p>
        </li>
      ))
    }
  </ul>
</Section>
