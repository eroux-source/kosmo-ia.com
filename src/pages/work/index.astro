---
/** /work : productions IA (ai-work.ts) et films du studio (projects.json, aucun DOOH) mélangés dans une mosaïque. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/layout/PageTop.astro';
import Footer from '../../components/layout/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import TwoTone from '../../components/ui/TwoTone.astro';
import MosaicCard from '../../components/ui/MosaicCard.astro';
import Contact from '../../components/sections/Contact.astro';
import { foohItem } from '../../lib/mosaic';
import { foohProjects } from '../../lib/fooh';
import { aiItem, aiWorks } from '../../data/ai-work';
import { breadcrumbJsonLd, SITE } from '../../lib/seo';

/* Une seule mosaïque : productions IA et films du studio en alternance (demande d'Eugène du 02/11/2026). Chaque carte
   garde son étiquette réelle (AI concept, AI production, FOOH) : les films CGI ne sont pas présentés comme de l'IA. */
const ai = aiWorks.map(aiItem);
const studio = foohProjects.map(foohItem);
const items = Array.from({ length: Math.max(ai.length, studio.length) }, (_, i) => [ai[i], studio[i]]).flat().filter(Boolean);

const title = 'Work: Films for Brands by KOSMO® AI';
const description = `${aiWorks.length} AI productions and ${foohProjects.length} studio films by KOSMO®: AI spots, fashion films and social content, plus CGI work for Netflix, Zalando and Porsche.`;
---

<BaseLayout title={title} description={description} path="/work" jsonLd={[
    breadcrumbJsonLd([{ name: 'KOSMO® AI', path: '/' }, { name: 'Work', path: '/work' }]),
    { '@type': 'ItemList', name: 'KOSMO® AI work', numberOfItems: items.length, itemListElement: items.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: `${item.brand}: ${item.title}`, url: `${SITE.url}${item.href}` })) },
  ]}>
  <PageTop />
  <main>
    <Section spacing="lg" data-fade="trigger">
      <Eyebrow label={`work · ${items.length} films`} />
      <div class="mt-(--head-gap) grid grid-cols-2 items-end gap-10 max-lg:grid-cols-1">
        <h1 data-stagger-text class="heading-h3"><TwoTone text="Films people stop for, made for brands." /></h1>
        <p data-fade="target" class="max-w-(--head-intro-max) justify-self-end text-body-medium text-(--body-soft) max-lg:justify-self-start">
          AI spots, fashion films, social content and launch films for Netflix, Zalando, Porsche and more, all made by the KOSMO® team. Hover a film to see how it was made.
        </p>
      </div>
      <ul data-fade="target" data-mosaic class="mt-12 grid grid-flow-row-dense grid-cols-4 auto-rows-(--mosaic-unit) gap-x-(--mosaic-gap) max-md:grid-cols-2">
        {items.map((item) => <MosaicCard item={item} />)}
      </ul>
    </Section>
    <Contact id="contact" />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../../scripts/mosaic';
</script>
